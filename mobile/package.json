{
  "name": "blueperf-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Enveloppe mobile (Capacitor) de l'app web Blueperf, pour publication sur App Store et Google Play.",
  "scripts": {
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --iconBackgroundColor #0D1B2A --splashBackgroundColor #0D1B2A"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
